# Application
APP_NAME=ApexSteward
APP_ENV=local
APP_PORT=8080
APP_URL=http://localhost:8080

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=apex_steward
DB_USER=apex_user
DB_PASSWORD=change_me
POSTGRES_PORT=5432

# Mailpit (SMTP & Web UI)
SMTP_HOST=mailpit
SMTP_PORT=1025
# Leave SMTP_USER/SMTP_PASS empty for Mailpit; SMTP_ENCRYPTION: empty | tls | ssl
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=
SMTP_FROM=stewards@apexsteward.local
MAILPIT_PORT=8025

# PgAdmin (Optional Database GUI)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
