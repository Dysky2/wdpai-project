# Production settings for docker-compose.prod.yaml (shared VPS). Copy to `.env` on the server:
#   cp .env.production.example .env && chmod 600 .env
# Never commit the filled-in file. Empty values marked "required" stop `docker compose` with an error.
# Strong random values:  openssl rand -base64 24

# Application
APP_NAME=ApexSteward
APP_ENV=production
# Required: the only published port (HTTPS). A free high port (above 1024) agreed on the VPS.
APP_PORT=
# Secure flag of the session cookie. Keep true; `false` is only an emergency switch for plain HTTP.
SESSION_SECURE_COOKIE=true

# HTTPS: Let's Encrypt certificate for <DUCKDNS_SUBDOMAIN>.duckdns.org via DNS-01 (no port 80/443 needed).
# Required: the bare subdomain (e.g. "myapp", not "myapp.duckdns.org") and the token from duckdns.org.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
# Required: contact e-mail for the Let's Encrypt account (a real domain, not example.com).
ACME_EMAIL=
# Optional: test against the staging CA first (untrusted certificate, no rate limits), then comment out.
# ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Database (PostgreSQL, reachable only inside Docker). Required: DB_PASSWORD (openssl rand -base64 24).
DB_NAME=apex_steward
DB_USER=apex_user
DB_PASSWORD=

# Mail. Default: internal Mailpit (start with `--profile tools`). For a real SMTP server set host, port,
# credentials and SMTP_ENCRYPTION (tls | ssl).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=
SMTP_FROM=stewards@apexsteward.local

# Optional tools (`--profile tools`), bound to 127.0.0.1 on the VPS and opened through an SSH tunnel.
# 127.0.0.1 is shared with other VPS users: pick free ports and set the credentials below.
MAILPIT_PORT=
# Mailpit web UI basic auth, format user:password
MAILPIT_UI_AUTH=
PGADMIN_PORT=
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
